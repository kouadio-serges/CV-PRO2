# Base de données PostgreSQL (Supabase)
# Pooler Supabase (Port 6543) - utilisé pour les requêtes applicatives
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connexion directe Supabase (Port 5432) - utilisé pour les migrations Prisma
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# NextAuth v4 (Auth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="votre_secret_nextauth_genere_avec_openssl_rand_hex_32"

# Google OAuth (Optionnel)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# CinetPay API Aurore (v1)
CINETPAY_API_KEY=""
CINETPAY_API_PASSWORD=""

# Supabase Storage Configuration
NEXT_PUBLIC_SUPABASE_URL="https://jifpjjfeckcypikhnwow.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="votre_cle_service_role_recuperee_dans_supabase_settings_api"

